# AI Personal Finance Advisor Environment Variables Example
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# LLM Integration Configuration (Provider-Agnostic / Local Llama / OpenAI-Compatible)
LLM_PROVIDER=openai
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=ollama
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1000

# Hosted Provider Placeholders (Optional: Groq, Together, OpenRouter, Anthropic)
# GROQ_API_KEY=gsk_your_groq_api_key_here
# TOGETHER_API_KEY=your_together_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
